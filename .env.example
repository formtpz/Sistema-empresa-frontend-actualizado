# Copiar a .env.local. Nunca subir contraseñas reales a GitHub.
# Utilizar la cadena de conexión PostgreSQL del pooler de Supabase.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres
# Generar un secreto aleatorio de 32 bytes o más; usar el mismo en todas las rutas.
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
